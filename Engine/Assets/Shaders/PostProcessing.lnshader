#shader vertex
#version 460 core

layout(location = 0) in vec2 iPosition;
layout(location = 1) in vec2 iTexCoord;

out vec2 vTexCoord;

void main()
{
	vTexCoord = iTexCoord;
	gl_Position = vec4(iPosition, 0.0, 1.0);
}

#shader fragment
#version 460 core

in vec2 vTexCoord;
layout(location = 0) out vec4 oFragment;

uniform sampler2D uScreenTexture;
uniform vec2 uResolution;
uniform float uBloomEnabled;
uniform float uBloomStrength;
uniform float uBloomThreshold;
uniform float uColorCorrectionEnabled;
uniform float uBrightness;
uniform float uContrast;
uniform float uSaturation;
uniform float uGamma;
uniform vec3 uTint;
uniform float uVignetteEnabled;
uniform float uVignetteStrength;
uniform float uChromaticAberrationEnabled;
uniform float uChromaticAberration;
uniform float uMotionBlurEnabled;
uniform float uMotionBlurStrength;
uniform int uColorVisionMode;
uniform float uFade;

vec3 sampleChromatic(vec2 uv)
{
	uv = clamp(uv, vec2(0.0), vec2(1.0));
	if (uChromaticAberrationEnabled < 0.5)
		return texture(uScreenTexture, uv).rgb;

	vec2 direction = uv - vec2(0.5);
	vec2 offset = direction * uChromaticAberration;
	return vec3(
		texture(uScreenTexture, uv + offset).r,
		texture(uScreenTexture, uv).g,
		texture(uScreenTexture, uv - offset).b);
}

vec3 sampleScene(vec2 uv)
{
	vec3 color = sampleChromatic(uv);
	if (uMotionBlurEnabled < 0.5 || uMotionBlurStrength <= 0.001)
		return color;

	vec2 velocity = (uv - vec2(0.5)) * uMotionBlurStrength * 0.075;
	for (int sampleIndex = 1; sampleIndex <= 5; ++sampleIndex)
		color += sampleChromatic(uv - velocity * (float(sampleIndex) / 5.0));

	return color / 6.0;
}

vec3 sampleBloom(vec2 uv)
{
	vec3 sampled = texture(uScreenTexture, clamp(uv, vec2(0.0), vec2(1.0))).rgb;
	float brightness = max(max(sampled.r, sampled.g), sampled.b);
	float threshold = max(uBloomThreshold, 0.001);
	float contribution = smoothstep(threshold * 0.55, threshold, brightness);
	return sampled * contribution;
}

vec3 applyColorVisionCorrection(vec3 color)
{
	if (uColorVisionMode == 0)
		return color;

	vec3 simulated = color;
	if (uColorVisionMode == 1)
		simulated = vec3(0.567 * color.r + 0.433 * color.g,
			0.558 * color.r + 0.442 * color.g, 0.242 * color.g + 0.758 * color.b);
	else if (uColorVisionMode == 2)
		simulated = vec3(0.625 * color.r + 0.375 * color.g,
			0.700 * color.r + 0.300 * color.g, 0.300 * color.g + 0.700 * color.b);
	else
		simulated = vec3(0.950 * color.r + 0.050 * color.g,
			0.433 * color.g + 0.567 * color.b, 0.475 * color.g + 0.525 * color.b);

	vec3 error = color - simulated;
	if (uColorVisionMode == 1)
		return max(color + vec3(0.0, error.r * 0.7 + error.g, error.r * 0.7 + error.b), vec3(0.0));
	if (uColorVisionMode == 2)
		return max(color + vec3(error.g * 0.7 + error.r, 0.0, error.g * 0.7 + error.b), vec3(0.0));
	return max(color + vec3(error.b * 0.7 + error.r, error.b * 0.7 + error.g, 0.0), vec3(0.0));
}

void main()
{
	vec3 color = sampleScene(vTexCoord);

	if (uBloomEnabled > 0.5)
	{
		vec2 texel = 1.0 / max(uResolution, vec2(1.0));
		vec3 glow = vec3(0.0);
		float weight = 0.0;
		for (int y = -3; y <= 3; ++y)
		{
			for (int x = -3; x <= 3; ++x)
			{
				float distanceSquared = float(x * x + y * y);
				float kernel = 1.0 / (1.0 + distanceSquared * 0.45);
				glow += sampleBloom(vTexCoord + vec2(x, y) * texel * 3.0) * kernel;
				weight += kernel;
			}
		}

		color += glow / max(weight, 0.001) * uBloomStrength * 1.65;
	}

	if (uColorCorrectionEnabled > 0.5)
	{
		color = (color - 0.5) * uContrast + 0.5 + uBrightness;
		float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
		color = mix(vec3(luminance), color, uSaturation) * uTint;
		color = pow(max(color, vec3(0.0)), vec3(1.0 / max(uGamma, 0.01)));
	}

	if (uVignetteEnabled > 0.5)
	{
		vec2 centered = vTexCoord * 2.0 - 1.0;
		float edge = smoothstep(0.35, 1.25, dot(centered, centered));
		color *= 1.0 - edge * uVignetteStrength;
	}

	color = applyColorVisionCorrection(color);

	oFragment = vec4(color * (1.0 - clamp(uFade, 0.0, 1.0)), 1.0);
}
