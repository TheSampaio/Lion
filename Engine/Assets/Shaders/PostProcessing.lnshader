#shader vertex
#version 460 core

layout(location = 0) in vec2 iPosition;
layout(location = 1) in vec2 iTexCoord;

out vec2 vTexCoord;

void main()
{
	vTexCoord = iTexCoord;
	gl_Position = vec4(iPosition, 0.0, 1.0);
}

#shader fragment
#version 460 core

in vec2 vTexCoord;
layout(location = 0) out vec4 oFragment;

uniform sampler2D uScreenTexture;
uniform vec2 uResolution;
uniform float uBloomEnabled;
uniform float uBloomStrength;
uniform float uBloomThreshold;
uniform float uColorCorrectionEnabled;
uniform float uBrightness;
uniform float uContrast;
uniform float uSaturation;
uniform float uGamma;
uniform vec3 uTint;
uniform float uVignetteEnabled;
uniform float uVignetteStrength;
uniform float uChromaticAberrationEnabled;
uniform float uChromaticAberration;

vec3 sampleScene(vec2 uv)
{
	if (uChromaticAberrationEnabled < 0.5)
		return texture(uScreenTexture, uv).rgb;

	vec2 direction = uv - vec2(0.5);
	vec2 offset = direction * uChromaticAberration;
	return vec3(
		texture(uScreenTexture, uv + offset).r,
		texture(uScreenTexture, uv).g,
		texture(uScreenTexture, uv - offset).b);
}

void main()
{
	vec3 color = sampleScene(vTexCoord);

	if (uBloomEnabled > 0.5)
	{
		vec2 texel = 1.0 / max(uResolution, vec2(1.0));
		vec3 glow = vec3(0.0);
		float weight = 0.0;

		for (int y = -2; y <= 2; ++y)
		{
			for (int x = -2; x <= 2; ++x)
			{
				float kernel = 1.0 / (1.0 + float(x * x + y * y));
				vec3 sampleColor = texture(uScreenTexture, vTexCoord + vec2(x, y) * texel * 2.0).rgb;
				float brightness = max(max(sampleColor.r, sampleColor.g), sampleColor.b);
				glow += sampleColor * smoothstep(uBloomThreshold, 1.0, brightness) * kernel;
				weight += kernel;
			}
		}

		color += glow / max(weight, 0.001) * uBloomStrength;
	}

	if (uColorCorrectionEnabled > 0.5)
	{
		color = (color - 0.5) * uContrast + 0.5 + uBrightness;
		float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
		color = mix(vec3(luminance), color, uSaturation) * uTint;
		color = pow(max(color, vec3(0.0)), vec3(1.0 / max(uGamma, 0.01)));
	}

	if (uVignetteEnabled > 0.5)
	{
		vec2 centered = vTexCoord * 2.0 - 1.0;
		float edge = smoothstep(0.35, 1.25, dot(centered, centered));
		color *= 1.0 - edge * uVignetteStrength;
	}

	oFragment = vec4(color, 1.0);
}
